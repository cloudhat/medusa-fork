// 주문 도메인 스키마 (Medusa Order Module)
// datasource·generator는 이 파일 하나에만 선언. 같은 디렉토리의 .prisma 파일들이
// Prisma에 의해 단일 스키마로 합쳐지므로 중복 선언하지 않는다.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

//
// 핵심 설계 원칙:
//   1. 이중 레이어 구조 — OrderLineItem(주문 확정 시점의 불변 상품 스냅샷)과
//      OrderItem(이후 수량 상태 변화 추적)을 별도 테이블로 분리해 보관.
//      OrderItem.item_id → OrderLineItem으로 연결된다.
//   2. 버전 관리 — Order.version이 증가할 때마다 OrderItem, OrderSummary,
//      OrderTransaction이 동기화된다.
//   3. 합계는 DB 컬럼이 아닌 런타임 계산 — decorateCartTotals()가 계산 후
//      OrderSummary.raw_original_total JSON에 저장.
//   4. 조정(Adjustment)·세금(TaxLine) 분리 — LineItem과 ShippingMethod 각각
//      별도 Adjustment / TaxLine 테이블로 프로모션·세금 내역을 세분 관리한다.

// 주문의 라이프사이클 상태.
// draft → pending → completed / canceled / requires_action 흐름.
enum OrderStatus {
  pending
  completed
  canceled
  requires_action
  draft
}

// 주문 변경 요청(OrderChange)의 승인 흐름.
// pending → requested → confirmed / declined / canceled 단방향 진행.
enum OrderChangeStatus {
  pending
  requested
  confirmed
  declined
  canceled
}

// OrderChange의 변경 유형.
enum OrderChangeType {
  return
  exchange
  claim
  edit
}

// 반품 처리 단계.
enum ReturnStatus {
  requested
  received
  partially_received
  canceled
}

// 클레임(Claim) 유형.
enum ClaimType {
  refund
  replace
}

// 주문의 최상위 엔티티.
//
// version: 주문 변경이 확정될 때마다 증가.
// display_id: 사람이 읽는 주문번호(자동 증가 정수).
// is_draft_order: 관리자가 백오피스에서 직접 생성하는 초안 주문 여부.
model Order {
  id               String      @id @default(cuid())
  display_id       Int?        @unique
  region_id        String?
  customer_id      String?
  sales_channel_id String?
  email            String?
  currency_code    String
  status           OrderStatus @default(pending)
  version          Int         @default(1)
  is_draft_order   Boolean     @default(false)
  metadata         Json?
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  items            OrderItem[]
  shipping_methods OrderShippingMethod[]
  shipping_address OrderAddress?         @relation("ShippingAddress")
  billing_address  OrderAddress?         @relation("BillingAddress")
  summary          OrderSummary?
  transactions     OrderTransaction[]
  changes          OrderChange[]
  returns          Return[]
  claims           Claim[]
  exchanges        Exchange[]
  credit_lines     OrderCreditLine[]
}

// 수량 상태 추적 레이어 — 버전별 주문 아이템 상태를 기록.
//
// item_id: OrderLineItem(상품 스냅샷)과의 연결 키.
// version: 이 레코드가 속한 Order.version 시점.
// *_quantity: 각 처리 단계별 수량. fulfilled=출고, shipped=발송, delivered=수령,
//             return_requested/received/dismissed=반품 단계, written_off=재고 폐기.
model OrderItem {
  id                         String   @id @default(cuid())
  version                    Int      @default(1)
  unit_price                 Decimal?
  compare_at_unit_price      Decimal?
  quantity                   Decimal
  fulfilled_quantity         Decimal  @default(0)
  delivered_quantity         Decimal  @default(0)
  shipped_quantity           Decimal  @default(0)
  return_requested_quantity  Decimal  @default(0)
  return_received_quantity   Decimal  @default(0)
  return_dismissed_quantity  Decimal  @default(0)
  written_off_quantity       Decimal  @default(0)
  metadata                   Json?
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  order_id String
  order    Order         @relation(fields: [order_id], references: [id])
  item_id  String
  item     OrderLineItem @relation(fields: [item_id], references: [id])
}

// 상품 스냅샷 레이어 — 주문 확정 시점의 상품 정보를 불변 저장.
//
// 이 엔티티의 모든 필드는 주문 확정 이후 변경되지 않는다.
// 원본 상품·variant가 삭제·수정되어도 주문 이력이 보존된다.
// unit_price: 주문 확정 시점의 단가.
// is_tax_inclusive: 단가에 세금이 포함된 가격 구조인지 여부.
model OrderLineItem {
  id                    String   @id @default(cuid())
  title                 String
  subtitle              String?
  thumbnail             String?
  variant_id            String?
  product_id            String?
  product_title         String?
  product_description   String?
  product_subtitle      String?
  product_type          String?
  product_type_id       String?
  product_collection    String?
  product_handle        String?
  variant_sku           String?
  variant_barcode       String?
  variant_title         String?
  variant_option_values Json?
  requires_shipping     Boolean  @default(true)
  is_giftcard           Boolean  @default(false)
  is_discountable       Boolean  @default(true)
  is_tax_inclusive      Boolean  @default(false)
  compare_at_unit_price Decimal?
  unit_price            Decimal?
  is_custom_price       Boolean  @default(false)
  metadata              Json?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  order_items    OrderItem[]
  tax_lines      OrderLineItemTaxLine[]
  adjustments    OrderLineItemAdjustment[]
  return_items   ReturnItem[]
  claim_items    OrderClaimItem[]
  exchange_items OrderExchangeItem[]
}

// 라인 아이템 할인 조정 — 프로모션·쿠폰 적용 내역.
//
// promotion_id: 적용된 프로모션 참조.
// amount: 이 조정으로 감소되는 금액 (양수 저장, 할인이므로 실제로는 차감).
model OrderLineItemAdjustment {
  id             String   @id @default(cuid())
  version        Int      @default(1)
  description    String?
  promotion_id   String?
  code           String?
  amount         Decimal
  provider_id    String?
  is_tax_inclusive Boolean @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  item_id String
  item    OrderLineItem @relation(fields: [item_id], references: [id])
}

// 라인 아이템 세금 내역.
//
// rate: 세율 (예: 10.00 = 10%).
// code: 세금 코드 (예: "VAT", "GST").
model OrderLineItemTaxLine {
  id          String   @id @default(cuid())
  description String?
  tax_rate_id String?
  code        String
  rate        Decimal
  provider_id String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  item_id String
  item    OrderLineItem @relation(fields: [item_id], references: [id])
}

// 주문에 적용된 배송 방법과 배송비.
//
// is_tax_inclusive: 배송비에 세금 포함 여부.
// is_custom_amount: 관리자가 직접 지정한 배송비 여부.
// data: 배송사에 전달하는 추가 데이터 (배송 업체별 커스텀 필드).
model OrderShippingMethod {
  id                 String   @id @default(cuid())
  name               String
  description        Json?
  amount             Decimal
  is_tax_inclusive   Boolean  @default(false)
  is_custom_amount   Boolean  @default(false)
  shipping_option_id String?
  data               Json?
  metadata           Json?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  order_id    String
  order       Order                          @relation(fields: [order_id], references: [id])
  tax_lines   OrderShippingMethodTaxLine[]
  adjustments OrderShippingMethodAdjustment[]
}

// 배송비 할인 조정.
model OrderShippingMethodAdjustment {
  id               String   @id @default(cuid())
  version          Int      @default(1)
  description      String?
  promotion_id     String?
  code             String?
  amount           Decimal
  provider_id      String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  shipping_method_id String
  shipping_method    OrderShippingMethod @relation(fields: [shipping_method_id], references: [id])
}

// 배송비 세금 내역.
model OrderShippingMethodTaxLine {
  id          String   @id @default(cuid())
  description String?
  tax_rate_id String?
  code        String
  rate        Decimal
  provider_id String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  shipping_method_id String
  shipping_method    OrderShippingMethod @relation(fields: [shipping_method_id], references: [id])
}

// 배송지 또는 청구지 주소.
//
// @relation 이름("ShippingAddress", "BillingAddress")으로 두 관계를 구분.
model OrderAddress {
  id           String   @id @default(cuid())
  first_name   String?
  last_name    String?
  phone        String?
  company      String?
  address_1    String?
  address_2    String?
  city         String?
  country_code String?
  province     String?
  postal_code  String?
  metadata     Json?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  shipping_order_id String? @unique
  shipping_order    Order?  @relation("ShippingAddress", fields: [shipping_order_id], references: [id])
  billing_order_id  String? @unique
  billing_order     Order?  @relation("BillingAddress", fields: [billing_order_id], references: [id])
}

// 주문 금액 합계 — 런타임 계산 결과를 캐싱하는 집계 테이블.
//
// raw_original_total: item_total, shipping_total, tax_total, discount_total 등
//                     상세 내역을 JSON으로 저장.
model OrderSummary {
  id                 String   @id @default(cuid())
  total              Decimal
  subtotal           Decimal
  tax_total          Decimal
  discount_total     Decimal
  shipping_total     Decimal
  raw_original_total Json?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  order_id String @unique
  order    Order  @relation(fields: [order_id], references: [id])
}

// 결제·환불 거래 내역.
//
// amount > 0: 결제. amount < 0: 환불.
// reference / reference_id: 연관 Return·Exchange·Claim 추적.
model OrderTransaction {
  id            String   @id @default(cuid())
  amount        Decimal
  currency_code String
  reference_id  String?
  reference     String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  order_id String
  order    Order  @relation(fields: [order_id], references: [id])
}

// 크레딧 지급 내역 — 주문에 크레딧(포인트·쿠폰 등)이 적용된 기록.
//
// reference / reference_id: 어떤 출처(프로모션, 반품 등)에서 발생했는지 추적.
// version: 이 크레딧이 속한 Order.version 시점.
model OrderCreditLine {
  id           String   @id @default(cuid())
  version      Int      @default(1)
  reference    String?
  reference_id String?
  amount       Decimal
  metadata     Json?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  order_id String
  order    Order  @relation(fields: [order_id], references: [id])
}

// 주문 변경 요청 — 반품·교환·클레임·수정 등 주문 후 변경 사항의 승인 흐름을 관리.
//
// confirmed 전까지 실제 주문 데이터에 반영되지 않는다.
model OrderChange {
  id           String            @id @default(cuid())
  status       OrderChangeStatus @default(pending)
  change_type  OrderChangeType?
  requested_by String?
  confirmed_by String?
  metadata     Json?
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt

  order_id String
  order    Order               @relation(fields: [order_id], references: [id])
  actions  OrderChangeAction[]
}

// OrderChange 안에 포함된 개별 변경 액션.
//
// action: 액션 유형 식별자 (예: "ITEM_ADD", "ITEM_REMOVE", "SHIPPING_ADD").
// reference / reference_id: 영향을 미치는 대상 엔티티 참조.
// amount: 이 액션으로 인한 금액 변화량.
model OrderChangeAction {
  id           String   @id @default(cuid())
  action       String
  reference    String?
  reference_id String?
  amount       Decimal?
  metadata     Json?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  order_change_id String
  order_change    OrderChange @relation(fields: [order_change_id], references: [id])
}

// 반품 요청 엔티티.
//
// 부분 반품: 하나의 주문에 여러 Return 레코드를 생성해 지원한다.
model Return {
  id            String       @id @default(cuid())
  status        ReturnStatus @default(requested)
  refund_amount Decimal?
  metadata      Json?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  order_id  String
  order     Order        @relation(fields: [order_id], references: [id])
  items     ReturnItem[]
  claims    Claim[]
  exchanges Exchange[]
}

// 반품 아이템 — Return 요청에 포함된 개별 아이템 수량 기록.
//
// received_quantity: 실제 입고 확인된 수량.
// damaged_quantity: 입고 시 파손이 확인된 수량.
// note: 이 아이템에 대한 반품 메모.
model ReturnItem {
  id                String   @id @default(cuid())
  quantity          Decimal
  received_quantity Decimal  @default(0)
  damaged_quantity  Decimal  @default(0)
  note              String?
  metadata          Json?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  return_id String
  return    Return        @relation(fields: [return_id], references: [id])
  item_id   String
  item      OrderLineItem @relation(fields: [item_id], references: [id])
  reason_id String?
  reason    ReturnReason? @relation(fields: [reason_id], references: [id])
}

// 반품 사유 코드 — 계층 구조(대분류·소분류)를 자기 참조로 표현.
//
// parent_return_reason_id: 상위 사유가 있으면 연결. null이면 최상위 분류.
// value: 코드값 (예: "wrong_item").
// label: 사용자에게 노출되는 사유명 (다국어 지원).
model ReturnReason {
  id          String   @id @default(cuid())
  value       String
  label       String
  description String?
  metadata    Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  parent_return_reason_id String?
  parent_return_reason    ReturnReason?  @relation("ReturnReasonChildren", fields: [parent_return_reason_id], references: [id])
  return_reason_children  ReturnReason[] @relation("ReturnReasonChildren")
  return_items            ReturnItem[]
}

// 클레임(분쟁·불량·오배송 등) 처리 엔티티.
//
// type=refund: 환불로 해결.
// type=replace: 재발송으로 해결.
// return_id: 반품이 수반될 경우 Return과 연결.
model Claim {
  id            String    @id @default(cuid())
  type          ClaimType
  refund_amount Decimal?
  metadata      Json?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  order_id         String
  order            Order            @relation(fields: [order_id], references: [id])
  return_id        String?
  return           Return?          @relation(fields: [return_id], references: [id])
  additional_items OrderClaimItem[]
}

// 클레임 대상 아이템.
//
// reason: 클레임 사유 (missing_item / wrong_item / production_failure / other).
// is_additional_item: 재발송 시 추가로 발송되는 신규 아이템이면 true.
//                     false이면 클레임을 제기한 원래 주문 아이템.
model OrderClaimItem {
  id                 String   @id @default(cuid())
  reason             String?
  quantity           Decimal
  is_additional_item Boolean  @default(false)
  note               String?
  metadata           Json?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  claim_id String
  claim    Claim         @relation(fields: [claim_id], references: [id])
  item_id  String
  item     OrderLineItem @relation(fields: [item_id], references: [id])
  images   OrderClaimItemImage[]
}

// 클레임 첨부 이미지 — 불량·오배송 증빙 사진.
model OrderClaimItemImage {
  id         String   @id @default(cuid())
  url        String
  metadata   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  claim_item_id String
  claim_item    OrderClaimItem @relation(fields: [claim_item_id], references: [id])
}

// 교환(동일·유사 상품으로 대체) 처리 엔티티.
//
// difference_due: 교환 상품의 가격 차이.
//                 양수면 고객이 추가 결제, 음수면 고객에게 차액을 환불한다.
// return_id: 반품되는 원래 상품의 Return과 연결.
model Exchange {
  id             String   @id @default(cuid())
  difference_due Decimal?
  metadata       Json?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  order_id         String
  order            Order               @relation(fields: [order_id], references: [id])
  return_id        String?
  return           Return?             @relation(fields: [return_id], references: [id])
  additional_items OrderExchangeItem[]
}

// 교환 아이템 — Exchange 요청에서 새로 발송되는 아이템.
model OrderExchangeItem {
  id         String   @id @default(cuid())
  quantity   Decimal
  note       String?
  metadata   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  exchange_id String
  exchange    Exchange      @relation(fields: [exchange_id], references: [id])
  item_id     String
  item        OrderLineItem @relation(fields: [item_id], references: [id])
}
