generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// 세금 공급자(TaxProvider). 외부 세금 계산 서비스 통합을 나타내는 레코드.
///
/// 라이프사이클:
///   - 세금 계산 공급자(예: TaxJar, Avalara) 등록 시 생성.
///   - TaxRegion.provider_id로 참조 → 최상위 리전에 세금 계산 엔진 지정.
///   - is_enabled = false이면 해당 공급자가 비활성화된 상태.
///
/// 모듈 연결:
///   - TaxRegion (1:N @relation, 최상위 리전만 provider 참조)
model TaxProvider {
  /// 공급자 고유 ID. 예: "tp_taxjar", "tp_system"
  id String @id

  /// true이면 이 공급자가 활성화된 상태
  is_enabled Boolean @default(true)

  regions TaxRegion[]
}

/// 세금 지역(TaxRegion). 국가·주/도 단위로 세금 규칙을 묶는 계층적 단위.
///
/// 계층 구조:
///   - 최상위(parent_id IS NULL): 국가 전체에 적용. TaxProvider 참조 가능.
///   - 하위(parent_id IS NOT NULL): 특정 주/도에 적용. province_code 필수.
///
/// DB CHECK 제약 (마이그레이션 SQL에서 추가 필요):
///   - CK_tax_region_provider_top_level: 하위 리전은 provider_id를 가질 수 없다 (parent_id IS NULL OR provider_id IS NULL)
///   - CK_tax_region_country_top_level:  하위 리전은 province_code가 필수다 (parent_id IS NULL OR province_code IS NOT NULL)
///
/// 라이프사이클:
///   - 어드민에서 생성·관리.
///   - Cart 세금 계산 시 shipping address의 country_code·province_code로 매칭.
///   - TaxRate.tax_region_id로 참조 → 해당 리전의 세율 목록 조회.
///
/// 모듈 연결:
///   - Region 모듈과 country_code 기준으로 연결 (Remote Link 없음, 코드 문자열로 매칭)
///   - TaxRate (1:N @relation)
model TaxRegion {
  /// 세금 지역 고유 ID
  id String @id

  /// ISO 3166-1 alpha-2 국가 코드. 예: "kr", "us"
  country_code String

  /// ISO 3166-2 주/도 코드. null이면 해당 국가 전체에 적용. 예: "KR-11"(서울)
  province_code String?

  /// 확장 가능한 키-값 커스텀 데이터
  metadata Json?

  /// 이 리전을 생성한 사용자/서비스 ID
  created_by String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  /// 세금 계산 공급자 ID. 최상위 리전(parent_id IS NULL)에서만 설정 가능
  provider_id String?
  provider    TaxProvider? @relation(fields: [provider_id], references: [id])

  /// 상위 세금 지역 ID. null이면 최상위(국가 단위) 리전
  parent_id String?
  parent    TaxRegion?  @relation("TaxRegionHierarchy", fields: [parent_id], references: [id])
  children  TaxRegion[] @relation("TaxRegionHierarchy")

  tax_rates TaxRate[]

  /// (country_code, province_code) 조합은 유일해야 한다
  /// province_code IS NULL인 경우의 partial unique는 마이그레이션 SQL에서 별도 추가 필요
  @@unique([country_code, province_code], name: "IDX_tax_region_unique_country_province")
}

/// 세율(TaxRate). 특정 세금 지역에 적용되는 세율 항목.
///
/// 라이프사이클:
///   - TaxRegion 생성 후 해당 리전에 세율 추가.
///   - is_default = true인 세율은 리전당 1개만 허용 (partial unique 제약, 마이그레이션 SQL 필요).
///   - TaxRateRule을 통해 특정 상품·상품 타입에 오버라이드 세율 지정 가능.
///   - Cart 세금 계산 시 적용 대상 세율 조회 → rate 값을 소계에 곱해 세액 산출.
///
/// 모듈 연결:
///   - TaxRegion (N:1 @relation)
///   - TaxRateRule (1:N @relation)
model TaxRate {
  /// 세율 고유 ID
  id String @id

  /// 세율 값 (%). 예: 10.0 → 10%. null이면 공급자가 동적으로 계산
  rate Float?

  /// 세율 식별 코드. 예: "VAT", "GST"
  code String

  /// 세율 표시 이름. 예: "부가가치세", "Standard VAT"
  name String

  /// true이면 이 리전의 기본 세율. tax_region_id당 1개만 허용
  is_default Boolean @default(false)

  /// true이면 상위 리전 세율과 합산 적용 (복합세). false이면 단독 적용
  is_combinable Boolean @default(false)

  /// 확장 가능한 키-값 커스텀 데이터
  metadata Json?

  /// 이 세율을 생성한 사용자/서비스 ID
  created_by String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  /// 이 세율이 속한 세금 지역 ID
  tax_region_id String
  tax_region    TaxRegion @relation(fields: [tax_region_id], references: [id])

  rules TaxRateRule[]

  @@index([tax_region_id], name: "IDX_tax_rate_tax_region_id")
}

/// 세율 적용 규칙(TaxRateRule). 특정 세율을 특정 엔티티(상품·타입 등)에 오버라이드 적용하는 규칙.
///
/// 라이프사이클:
///   - TaxRate 생성 후, 해당 세율을 특정 상품/타입에만 적용하고 싶을 때 추가.
///   - Cart 세금 계산 시 LineItem의 product_id·product_type_id와 reference_id를 매칭
///     → 일반 세율 대신 이 규칙의 세율을 적용.
///
/// 모듈 연결:
///   - TaxRate (N:1 @relation)
///   - Product·ProductType (Remote Link 없음, reference/reference_id 문자열로 매칭)
model TaxRateRule {
  /// 규칙 고유 ID
  id String @id

  /// 적용 대상 엔티티 타입. 예: "product", "product_type"
  reference String

  /// 적용 대상 엔티티 ID. 예: 특정 product.id 또는 product_type.id
  reference_id String

  /// 확장 가능한 키-값 커스텀 데이터
  metadata Json?

  /// 이 규칙을 생성한 사용자/서비스 ID
  created_by String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  /// 이 규칙이 속한 세율 ID
  tax_rate_id String
  tax_rate    TaxRate @relation(fields: [tax_rate_id], references: [id])

  /// (tax_rate_id, reference_id) 조합은 유일해야 한다 — 동일 세율에 같은 엔티티를 중복 지정 불가
  @@unique([tax_rate_id, reference_id], name: "IDX_tax_rate_rule_unique_rate_reference")
  @@index([reference_id], name: "IDX_tax_rate_rule_reference_id")
}
