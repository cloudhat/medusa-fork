generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// 결제 묶음 상태. 결제 진행 단계를 나타낸다.
/// - not_paid: 초기 상태. 결제 시도 없음.
/// - awaiting: PaymentSession이 생성되어 고객이 결제 진행 중.
/// - authorized: PG사에서 결제 승인 완료.
/// - partially_authorized: 복수 세션 중 일부만 승인된 상태.
/// - captured: 전액 실제 청구 완료.
/// - partially_captured: 일부 금액만 청구 완료.
/// - requires_action: 추가 인증(예: 3DS) 필요.
/// - canceled: 결제 취소.
/// - partially_refunded: 일부 금액 환불 완료.
/// - refunded: 전액 환불 완료.
enum PaymentCollectionStatus {
  not_paid
  awaiting
  authorized
  partially_authorized
  captured
  partially_captured
  requires_action
  canceled
  partially_refunded
  refunded
}

/// 결제 세션 상태. PG사와의 1회 결제 시도 진행 상태.
/// - pending: 세션 생성됨. 고객이 결제 정보 입력 중.
/// - requires_more: 3DS 등 추가 인증 필요.
/// - authorized: PG 승인 완료. 이 시점에 Payment 레코드가 생성됨.
/// - captured: 실제 청구 완료.
/// - error: PG 처리 오류.
/// - canceled: 세션 취소.
enum PaymentSessionStatus {
  pending
  authorized
  captured
  requires_more
  error
  canceled
}

/// 결제 공급자(PaymentProvider). 시스템에 등록된 결제 프로바이더 레지스트리.
///
/// 라이프사이클:
///   - 플러그인/설정으로 프로바이더를 등록할 때 자동 생성 또는 어드민에서 활성화.
///   - PaymentCollection과 M2M으로 연결 → 해당 컬렉션에서 사용 가능한 결제 수단 정의.
///
/// 참고: id는 자동 생성 UUID가 아닌 프로바이더 식별자 자체. 예: "pp_stripe_stripe".
model PaymentProvider {
  /// 프로바이더 식별자 (prefix 없는 고정 문자열). 예: "pp_stripe_stripe"
  id String @id

  /// true이면 이 프로바이더로 결제 가능. false이면 비활성화
  is_enabled Boolean @default(true)

  payment_collections PaymentCollectionProvider[]
}

/// 결제 묶음(PaymentCollection). 하나의 주문·카트에 대한 결제 시도 전체를 관리하는 컨테이너.
///
/// 라이프사이클:
///   - 카트 또는 주문에 결제가 필요할 때 생성. Cart/Order와는 Remote Link로 연결.
///   - PaymentSession을 통해 고객이 결제를 시도하고, 승인 시 Payment가 생성됨.
///   - 복수의 결제 수단(PaymentProvider) 사용 허용 (M2M).
///   - 상태는 하위 세션·결제 상태에 따라 자동으로 업데이트됨.
///
/// 금액 필드 관계:
///   - amount: 결제 요청 총액.
///   - authorized_amount: PG 승인 누계 금액 (capture 전 단계).
///   - captured_amount: 실제 청구 완료 누계 금액.
///   - refunded_amount: 환불 완료 누계 금액.
///
/// 모듈 연결 (Remote Link, 이 스키마에 FK 없음):
///   - Cart.payment_collection_id, Order.payment_collection_id (cross-module 참조)
model PaymentCollection {
  /// 결제 묶음 고유 ID (prefix: pay_col_)
  id String @id

  /// 결제 통화 코드. 예: "usd", "krw"
  currency_code String

  /// 결제 요청 총액
  amount Decimal

  /// amount의 정밀도 보존용 원본 JSON (bigNumber 저장 방식)
  raw_amount Json

  /// PG 승인 완료 금액 누계. 승인 전 null
  authorized_amount Decimal?

  /// authorized_amount의 정밀도 보존용 원본 JSON
  raw_authorized_amount Json?

  /// 실제 청구 완료 금액 누계. capture 전 null
  captured_amount Decimal?

  /// captured_amount의 정밀도 보존용 원본 JSON
  raw_captured_amount Json?

  /// 환불 완료 금액 누계. 환불 전 null
  refunded_amount Decimal?

  /// refunded_amount의 정밀도 보존용 원본 JSON
  raw_refunded_amount Json?

  /// 전액 결제 완료(COMPLETED 상태 전환) 시각. null이면 미완료
  completed_at DateTime?

  /// 결제 묶음 상태
  status PaymentCollectionStatus @default(not_paid)

  /// 확장 가능한 키-값 커스텀 데이터
  metadata Json?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  payment_providers PaymentCollectionProvider[]
  payment_sessions  PaymentSession[]
  payments          Payment[]
}

/// 결제묶음-공급자 연결(PaymentCollectionProvider). PaymentCollection ↔ PaymentProvider 다대다 피벗 테이블.
///
/// 이 컬렉션에서 사용 가능한 결제 수단 목록을 정의한다.
model PaymentCollectionProvider {
  payment_collection_id String
  payment_provider_id   String

  payment_collection PaymentCollection @relation(fields: [payment_collection_id], references: [id])
  payment_provider   PaymentProvider   @relation(fields: [payment_provider_id], references: [id])

  @@id([payment_collection_id, payment_provider_id])
  @@map("payment_collection_payment_provider")
}

/// 결제 세션(PaymentSession). 고객이 특정 결제 수단으로 결제를 시도하는 1회 세션.
///
/// 라이프사이클:
///   - 고객이 결제 수단을 선택하고 결제를 시작할 때 생성.
///   - PG사와의 통신 데이터(외부 세션 토큰 등)를 data 필드에 저장.
///   - status = authorized가 되면 Payment 레코드가 생성되고 이 세션과 1:1로 연결.
///   - 결제 실패 또는 취소 시 이 레코드만 남고 Payment는 생성되지 않음.
model PaymentSession {
  /// 결제 세션 고유 ID (prefix: payses_)
  id String @id

  /// 결제 통화 코드
  currency_code String

  /// 이 세션의 결제 금액
  amount Decimal

  /// amount의 정밀도 보존용 원본 JSON
  raw_amount Json

  /// 결제 프로바이더 식별자. 예: "pp_stripe_stripe" (text 참조, FK 없음)
  provider_id String

  /// PG사에서 반환한 외부 데이터. 예: 세션 토큰, 외부 결제 ID 등
  data Json @default("{}")

  /// 결제 시 PG사에 전달할 컨텍스트. 예: 고객 이메일, 청구 주소. null 허용
  context Json?

  /// 세션 상태
  status PaymentSessionStatus @default(pending)

  /// PG 승인 완료 시각. authorized 상태가 된 시점. null이면 미승인
  authorized_at DateTime?

  /// 확장 가능한 키-값 커스텀 데이터
  metadata Json?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  /// 소속 결제 묶음 ID
  payment_collection_id String
  payment_collection    PaymentCollection @relation(fields: [payment_collection_id], references: [id])

  payment Payment?

  @@index([payment_collection_id], name: "IDX_payment_session_payment_collection_id")
}

/// 결제(Payment). PaymentSession이 authorized 상태가 된 시점에 생성되는 확정 결제 레코드.
///
/// 라이프사이클:
///   - PaymentSession.status = authorized 전환 시 자동 생성. PaymentSession과 1:1 대응.
///   - 이후 Capture를 통해 실제 청구. 복수 Capture 가능 (분할 청구).
///   - Refund를 통해 환불. 복수 Refund 가능.
///   - canceled_at이 설정되면 결제 취소 상태.
model Payment {
  /// 결제 고유 ID (prefix: pay_)
  id String @id

  /// 결제 금액
  amount Decimal

  /// amount의 정밀도 보존용 원본 JSON
  raw_amount Json

  /// 결제 통화 코드
  currency_code String

  /// 결제 프로바이더 식별자 (text 참조, FK 없음)
  provider_id String

  /// PG사 응답 데이터. 예: 외부 결제 ID, 거래 참조 번호. null 허용
  data Json?

  /// 확장 가능한 키-값 커스텀 데이터
  metadata Json?

  /// 최초 Capture 완료 시각. capture 전 null
  captured_at DateTime?

  /// 결제 취소 시각. 취소 전 null
  canceled_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  /// 소속 결제 묶음 ID
  payment_collection_id String
  payment_collection    PaymentCollection @relation(fields: [payment_collection_id], references: [id])

  /// 연결된 결제 세션 ID (1:1)
  payment_session_id String         @unique
  payment_session    PaymentSession @relation(fields: [payment_session_id], references: [id])

  refunds  Refund[]
  captures Capture[]

  @@index([provider_id], name: "IDX_payment_provider_id")
  @@index([payment_collection_id], name: "IDX_payment_payment_collection_id")
  @@index([payment_session_id], name: "IDX_payment_payment_session_id")
}

/// 청구(Capture). Payment에서 실제로 고객에게 청구된 금액 레코드.
///
/// 라이프사이클:
///   - 관리자가 수동으로 또는 시스템이 자동으로 capture를 실행할 때 생성.
///   - Payment 1개에 복수의 Capture가 가능 (분할 청구).
///   - 수동 capture 시 created_by에 처리한 관리자 ID를 기록한다.
model Capture {
  /// 청구 고유 ID (prefix: capt_)
  id String @id

  /// 이 청구에서 고객에게 부과된 금액
  amount Decimal

  /// amount의 정밀도 보존용 원본 JSON
  raw_amount Json

  /// 확장 가능한 키-값 커스텀 데이터
  metadata Json?

  /// 수동 capture 시 처리한 관리자 ID. 자동 capture이면 null
  created_by String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  /// 소속 결제 ID
  payment_id String
  payment    Payment @relation(fields: [payment_id], references: [id])

  @@index([payment_id], name: "IDX_capture_payment_id")
}

/// 환불 사유(RefundReason). 환불 시 선택할 수 있는 사유 마스터 데이터.
///
/// 라이프사이클:
///   - 어드민에서 미리 정의. Refund 생성 시 선택적으로 참조.
///   - label과 description은 다국어 지원 대상.
model RefundReason {
  /// 환불 사유 고유 ID (prefix: refr_)
  id String @id

  /// 표시용 이름 (다국어). 예: "상품 불량", "단순 변심"
  label String

  /// 코드 식별자. 예: "defective", "customer_request"
  code String

  /// 상세 설명 (다국어). null 허용
  description String?

  /// 확장 가능한 키-값 커스텀 데이터
  metadata Json?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  refunds Refund[]
}

/// 환불(Refund). Payment에 대한 환불 1건.
///
/// 라이프사이클:
///   - 관리자가 환불을 실행할 때 생성. Payment 1개에 복수의 Refund 가능.
///   - refund_reason_id는 선택 사항 — 사유 없이 환불 가능.
///   - note로 환불 관련 추가 메모를 남길 수 있다.
model Refund {
  /// 환불 고유 ID (prefix: ref_)
  id String @id

  /// 환불 금액
  amount Decimal

  /// amount의 정밀도 보존용 원본 JSON
  raw_amount Json

  /// 추가 메모. null 허용
  note String?

  /// 환불을 처리한 관리자 ID. null 허용
  created_by String?

  /// 확장 가능한 키-값 커스텀 데이터
  metadata Json?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  /// 소속 결제 ID
  payment_id String
  payment    Payment @relation(fields: [payment_id], references: [id])

  /// 환불 사유 ID. null이면 사유 미지정
  refund_reason_id String?
  refund_reason    RefundReason? @relation(fields: [refund_reason_id], references: [id])

  @@index([payment_id], name: "IDX_refund_payment_id")
}

/// 계정 보유자(AccountHolder). 결제 프로바이더에 등록된 고객 계정 정보.
///
/// 역할:
///   - 특정 PG사에서 고객에게 발급된 외부 계정(고객 ID, 저장 카드 등)을 추적.
///   - (provider_id, external_id) 조합 unique — 동일 프로바이더의 동일 외부 ID는 1개만 허용.
///   - 저장 결제 수단(Saved Payment Method) 기능의 기반 레코드.
///
/// 모듈 연결 (Remote Link, 이 스키마에 FK 없음):
///   - Customer와 Remote Link로 연결 (customer 모듈)
model AccountHolder {
  /// 계정 보유자 고유 ID
  id String @id

  /// 결제 프로바이더 식별자. 예: "pp_stripe_stripe"
  provider_id String

  /// 프로바이더가 발급한 외부 고객 ID. 예: Stripe Customer ID ("cus_xxx")
  external_id String

  /// 고객 이메일. null 허용
  email String?

  /// 프로바이더에서 반환한 외부 데이터. 예: 저장 카드 목록, 결제 방법 정보
  data Json @default("{}")

  /// 확장 가능한 키-값 커스텀 데이터
  metadata Json?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  /// (provider_id, external_id) 조합 unique — 동일 프로바이더의 외부 계정 중복 불가
  @@unique([provider_id, external_id])
}
