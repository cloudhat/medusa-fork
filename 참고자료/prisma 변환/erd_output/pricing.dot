digraph "pricing" {
  graph [rankdir=LR splines=polyline nodesep=0.5 ranksep=1.2
         pad=0.5 label="pricing" labelloc=t fontsize=16
         fontname="Helvetica-Bold"]
  node  [shape=none margin=0]
  edge  [fontsize=7 fontname="Helvetica" arrowsize=0.75 dir=both]

  PriceSet [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
      <TR><TD BGCOLOR="#4A235A" ALIGN="CENTER" COLSPAN="2" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="9"><B>PriceSet</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="5.5"><B>PK</B></FONT></TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="7"><B>id: String</B></FONT></TD></TR>
    </TABLE>>]
  Price [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
      <TR><TD BGCOLOR="#4A235A" ALIGN="CENTER" COLSPAN="2" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="9"><B>Price</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="5.5"><B>PK</B></FONT></TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="7"><B>id: String</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">title: String?</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">currency_code: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">amount: Decimal</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">min_quantity: Decimal?</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">max_quantity: Decimal?</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">rules_count: Int?</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="5.5"><B>FK</B></FONT></TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="7"><I>price_set_id: String</I></FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="5.5"><B>FK</B></FONT></TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="7"><I>price_list_id: String?</I></FONT></TD></TR>
    </TABLE>>]
  PriceRule [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
      <TR><TD BGCOLOR="#4A235A" ALIGN="CENTER" COLSPAN="2" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="9"><B>PriceRule</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="5.5"><B>PK</B></FONT></TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="7"><B>id: String</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">attribute: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">value: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">operator: PricingRuleOperator</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">priority: Int</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="5.5"><B>FK</B></FONT></TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="7"><I>price_id: String</I></FONT></TD></TR>
    </TABLE>>]
  PriceList [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
      <TR><TD BGCOLOR="#4A235A" ALIGN="CENTER" COLSPAN="2" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="9"><B>PriceList</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="5.5"><B>PK</B></FONT></TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="7"><B>id: String</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">title: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">description: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">status: PriceListStatus</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">type: PriceListType</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">starts_at: DateTime?</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">ends_at: DateTime?</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">rules_count: Int?</FONT></TD></TR>
    </TABLE>>]
  PriceListRule [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
      <TR><TD BGCOLOR="#4A235A" ALIGN="CENTER" COLSPAN="2" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="9"><B>PriceListRule</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="5.5"><B>PK</B></FONT></TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="7"><B>id: String</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">attribute: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">value: Json?</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="5.5"><B>FK</B></FONT></TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="7"><I>price_list_id: String</I></FONT></TD></TR>
    </TABLE>>]
  PricePreference [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
      <TR><TD BGCOLOR="#4A235A" ALIGN="CENTER" COLSPAN="2" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="9"><B>PricePreference</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="5.5"><B>PK</B></FONT></TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="7"><B>id: String</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">attribute: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">value: String?</FONT></TD></TR>
      <TR><TD BGCOLOR="#E8DAEF" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#E8DAEF" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">is_tax_inclusive: Boolean</FONT></TD></TR>
    </TABLE>>]

  // Relations
  PriceSet -> Price [arrowtail=tee arrowhead=crow taillabel="1" headlabel="N"]
  PriceList -> Price [arrowtail=tee arrowhead=crowodot taillabel="1" headlabel="0..N"]
  Price -> PriceRule [arrowtail=tee arrowhead=crow taillabel="1" headlabel="N"]
  PriceList -> PriceListRule [arrowtail=tee arrowhead=crow taillabel="1" headlabel="N"]
}