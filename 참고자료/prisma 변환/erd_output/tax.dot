digraph "tax" {
  graph [rankdir=LR splines=polyline nodesep=0.5 ranksep=1.2
         pad=0.5 label="tax" labelloc=t fontsize=16
         fontname="Helvetica-Bold"]
  node  [shape=none margin=0]
  edge  [fontsize=7 fontname="Helvetica" arrowsize=0.75 dir=both]

  TaxProvider [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
      <TR><TD BGCOLOR="#2C2C2C" ALIGN="CENTER" COLSPAN="2" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="9"><B>TaxProvider</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="5.5"><B>PK</B></FONT></TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="7"><B>id: String</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">is_enabled: Boolean</FONT></TD></TR>
    </TABLE>>]
  TaxRegion [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
      <TR><TD BGCOLOR="#2C2C2C" ALIGN="CENTER" COLSPAN="2" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="9"><B>TaxRegion</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="5.5"><B>PK</B></FONT></TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="7"><B>id: String</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">country_code: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">province_code: String?</FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">created_by: String?</FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="5.5"><B>FK</B></FONT></TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="7"><I>provider_id: String?</I></FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="5.5"><B>FK</B></FONT></TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="7"><I>parent_id: String?</I></FONT></TD></TR>
    </TABLE>>]
  TaxRate [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
      <TR><TD BGCOLOR="#2C2C2C" ALIGN="CENTER" COLSPAN="2" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="9"><B>TaxRate</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="5.5"><B>PK</B></FONT></TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="7"><B>id: String</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">rate: Float?</FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">code: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">name: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">is_default: Boolean</FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">is_combinable: Boolean</FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">created_by: String?</FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="5.5"><B>FK</B></FONT></TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="7"><I>tax_region_id: String</I></FONT></TD></TR>
    </TABLE>>]
  TaxRateRule [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
      <TR><TD BGCOLOR="#2C2C2C" ALIGN="CENTER" COLSPAN="2" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="9"><B>TaxRateRule</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="5.5"><B>PK</B></FONT></TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="7"><B>id: String</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">reference: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">reference_id: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">created_by: String?</FONT></TD></TR>
      <TR><TD BGCOLOR="#F2F3F4" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="5.5"><B>FK</B></FONT></TD><TD BGCOLOR="#F2F3F4" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="7"><I>tax_rate_id: String</I></FONT></TD></TR>
    </TABLE>>]

  // Relations
  TaxProvider -> TaxRegion [arrowtail=tee arrowhead=crowodot taillabel="1" headlabel="0..N"]
  TaxRegion -> TaxRegion [arrowtail=tee arrowhead=crowodot taillabel="1" headlabel="0..N" label=" TaxRegionHierarchy "]
  TaxRegion -> TaxRate [arrowtail=tee arrowhead=crow taillabel="1" headlabel="N"]
  TaxRate -> TaxRateRule [arrowtail=tee arrowhead=crow taillabel="1" headlabel="N"]
}