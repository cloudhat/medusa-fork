digraph "stock-location" {
  graph [rankdir=LR splines=polyline nodesep=0.5 ranksep=1.2
         pad=0.5 label="stock-location" labelloc=t fontsize=16
         fontname="Helvetica-Bold"]
  node  [shape=none margin=0]
  edge  [fontsize=7 fontname="Helvetica" arrowsize=0.75 dir=both]

  StockLocationAddress [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
      <TR><TD BGCOLOR="#4D4D00" ALIGN="CENTER" COLSPAN="2" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="9"><B>StockLocationAddress</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#FDFDE7" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="5.5"><B>PK</B></FONT></TD><TD BGCOLOR="#FDFDE7" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="7"><B>id: String</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#FDFDE7" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#FDFDE7" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">address_1: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#FDFDE7" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#FDFDE7" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">address_2: String?</FONT></TD></TR>
      <TR><TD BGCOLOR="#FDFDE7" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#FDFDE7" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">company: String?</FONT></TD></TR>
      <TR><TD BGCOLOR="#FDFDE7" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#FDFDE7" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">city: String?</FONT></TD></TR>
      <TR><TD BGCOLOR="#FDFDE7" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#FDFDE7" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">country_code: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#FDFDE7" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#FDFDE7" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">phone: String?</FONT></TD></TR>
      <TR><TD BGCOLOR="#FDFDE7" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#FDFDE7" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">province: String?</FONT></TD></TR>
      <TR><TD BGCOLOR="#FDFDE7" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#FDFDE7" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">postal_code: String?</FONT></TD></TR>
    </TABLE>>]
  StockLocation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
      <TR><TD BGCOLOR="#4D4D00" ALIGN="CENTER" COLSPAN="2" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="9"><B>StockLocation</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#FDFDE7" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="5.5"><B>PK</B></FONT></TD><TD BGCOLOR="#FDFDE7" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="7"><B>id: String</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#FDFDE7" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#FDFDE7" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">name: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#FDFDE7" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="5.5"><B>FK</B></FONT></TD><TD BGCOLOR="#FDFDE7" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="7"><I>address_id: String?</I></FONT></TD></TR>
    </TABLE>>]

  // Relations
  StockLocationAddress -> StockLocation [arrowtail=tee arrowhead=crowodot taillabel="1" headlabel="0..N"]
}