digraph "region" {
  graph [rankdir=LR splines=polyline nodesep=0.5 ranksep=1.2
         pad=0.5 label="region" labelloc=t fontsize=16
         fontname="Helvetica-Bold"]
  node  [shape=none margin=0]
  edge  [fontsize=7 fontname="Helvetica" arrowsize=0.75 dir=both]

  Region [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
      <TR><TD BGCOLOR="#0E4D91" ALIGN="CENTER" COLSPAN="2" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="9"><B>Region</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#D6EAF8" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="5.5"><B>PK</B></FONT></TD><TD BGCOLOR="#D6EAF8" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="7"><B>id: String</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#D6EAF8" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#D6EAF8" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">name: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#D6EAF8" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#D6EAF8" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">currency_code: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#D6EAF8" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#D6EAF8" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">automatic_taxes: Boolean</FONT></TD></TR>
    </TABLE>>]
  RegionCountry [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
      <TR><TD BGCOLOR="#0E4D91" ALIGN="CENTER" COLSPAN="2" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="9"><B>RegionCountry</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#D6EAF8" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="5.5"><B>PK</B></FONT></TD><TD BGCOLOR="#D6EAF8" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#0D2D6B" POINT-SIZE="7"><B>iso_2: String</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#D6EAF8" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#D6EAF8" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">iso_3: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#D6EAF8" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#D6EAF8" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">num_code: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#D6EAF8" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#D6EAF8" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">name: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#D6EAF8" WIDTH="24" CELLPADDING="2">&nbsp;</TD><TD BGCOLOR="#D6EAF8" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#333333" POINT-SIZE="7">display_name: String</FONT></TD></TR>
      <TR><TD BGCOLOR="#D6EAF8" WIDTH="24" ALIGN="CENTER" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="5.5"><B>FK</B></FONT></TD><TD BGCOLOR="#D6EAF8" ALIGN="LEFT" CELLPADDING="2"><FONT COLOR="#8B1A1A" POINT-SIZE="7"><I>region_id: String?</I></FONT></TD></TR>
    </TABLE>>]

  // Relations
  Region -> RegionCountry [arrowtail=tee arrowhead=crowodot taillabel="1" headlabel="0..N"]
}