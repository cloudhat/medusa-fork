// 배송 도메인 스키마 (Medusa Fulfillment Module)
//
// 핵심 설계 원칙:
//   1. 배송 설정 계층: FulfillmentSet → ServiceZone → (GeoZone + ShippingOption).
//      cascade delete 체인: FulfillmentSet 삭제 → ServiceZone → GeoZone + ShippingOption.
//   2. ShippingOption 자체에 가격 없음. 가격은 Price Module과 링크 모듈로 별도 연결.
//   3. 실제 배송 처리: ShippingOption을 선택하면 Fulfillment 레코드가 생성됨.
//      하나의 주문에서 여러 Fulfillment를 생성해 부분 배송을 지원한다.

// 지역 범위의 정밀도 수준.
// country → province → city → zip 순으로 세밀해진다.
// 더 세밀한 타입을 가진 ServiceZone이 우선 매칭된다.
enum GeoZoneType {
  country   // 국가 전체
  province  // 주·도 단위 (예: 제주도, 경기도)
  city      // 시·군·구 단위
  zip       // 우편번호 범위·패턴
}

// 배송비 계산 방식.
// flat_rate: 고정 요금. Price Module에 등록된 가격을 그대로 적용.
// calculated: 배송사 API를 호출해 실시간으로 계산. FulfillmentProvider가 금액을 반환.
enum ShippingOptionPriceType {
  flat_rate
  calculated
}

// 배송 설정의 최상위 컨테이너.
//
// 일반적으로 재고 위치(Stock Location)와 링크 모듈로 연결된다.
// type: "shipping"(출고), "return"(반품 수거) 등 배송 세트의 성격을 구분.
// 복수의 창고가 있을 때 창고별로 별도 FulfillmentSet을 생성한다.
// service_zones: 이 배송 세트가 커버하는 지역 구분 단위 목록.
model FulfillmentSet {
  id         String   @id @default(cuid())
  name       String
  type       String
  metadata   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  service_zones ServiceZone[]
}

// FulfillmentSet 안에서 지역을 분리하는 단위.
//
// 동일 FulfillmentSet에서 지역별로 다른 배송 옵션과 요금을 제공할 때 사용.
// 예: "일반 ServiceZone"(전국)과 "제주·도서산간 ServiceZone"을 분리 생성.
// geo_zones: 이 존이 커버하는 실제 지리적 범위 (복수 허용).
// shipping_options: 이 지역 존에서 선택 가능한 배송 옵션 목록.
model ServiceZone {
  id         String   @id @default(cuid())
  name       String
  metadata   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fulfillment_set_id String
  fulfillment_set    FulfillmentSet   @relation(fields: [fulfillment_set_id], references: [id])
  geo_zones          GeoZone[]
  shipping_options   ShippingOption[]
}

// ServiceZone의 실제 지리적 범위를 정의하는 단위.
//
// type에 따라 사용하는 필드 조합이 달라진다:
//   country:  country_code만 필요 (예: "kr" = 한국 전체)
//   province: country_code + province_code (예: "kr" + "jeju" = 제주도)
//   city:     country_code + province_code + city (예: "kr" + "jeju" + "서귀포시")
//   zip:      country_code + postal_expression (예: 우편번호 패턴/범위 JSON)
//
// 도서산간 배송비 구현 예:
//   1. "제주 ServiceZone" 생성
//   2. type="province", country_code="kr", province_code="jeju" GeoZone 연결
//   3. 해당 ServiceZone에 도서산간 요금의 ShippingOption 연결
//
// postal_expression: zip 타입에서 우편번호 범위·패턴을 JSON으로 표현.
//                    예: { "gte": "63000", "lte": "63999" } (제주 우편번호 범위)
model GeoZone {
  id                String      @id @default(cuid())
  type              GeoZoneType
  country_code      String
  province_code     String?
  city              String?
  postal_expression Json?
  metadata          Json?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  service_zone_id String
  service_zone    ServiceZone @relation(fields: [service_zone_id], references: [id])
}

// 상품의 배송 특성을 분류하는 프로파일.
//
// 상품에 ShippingProfile을 연결해 배송 옵션 선택을 제한할 수 있다.
// 예: type="default"(일반 상품), type="digital"(디지털 상품), type="cold_chain"(냉장 상품).
// 여러 ShippingProfile의 상품이 같은 장바구니에 있으면, 프로파일별로 별도 배송 옵션 선택이 필요.
// shipping_options: 이 프로파일에 적용 가능한 배송 옵션 목록.
model ShippingProfile {
  id         String   @id @default(cuid())
  name       String
  type       String
  metadata   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shipping_options ShippingOption[]
}

// 특정 ServiceZone에서 선택 가능한 배송 옵션.
//
// 가격 필드가 없다. 요금은 Price Module과 링크 모듈을 통해 별도로 관리된다.
// price_type=flat_rate: Price Module에 등록된 고정 금액 적용.
// price_type=calculated: FulfillmentProvider가 실시간으로 계산한 금액 적용.
// data: 배송사에 전달할 추가 파라미터 (예: 서비스 코드, 포장 유형).
// service_zone_id: 이 옵션이 제공되는 지역 존.
// shipping_profile_id: 이 옵션이 적용 가능한 상품 배송 프로파일.
// provider_id: 이 옵션을 처리하는 배송 업체(FulfillmentProvider).
// fulfillments: 이 옵션으로 생성된 실제 배송 처리 건 목록.
model ShippingOption {
  id         String                  @id @default(cuid())
  name       String
  price_type ShippingOptionPriceType
  data       Json?
  metadata   Json?
  created_at DateTime                @default(now())
  updated_at DateTime                @updatedAt

  service_zone_id     String
  service_zone        ServiceZone          @relation(fields: [service_zone_id], references: [id])
  shipping_profile_id String?
  shipping_profile    ShippingProfile?     @relation(fields: [shipping_profile_id], references: [id])
  provider_id         String?
  provider            FulfillmentProvider? @relation(fields: [provider_id], references: [id])
  fulfillments        Fulfillment[]
}

// 실제 배송 처리 단위 — ShippingOption 선택 후 출고~배달 과정을 추적.
//
// 하나의 주문에서 여러 Fulfillment를 생성해 부분 배송을 지원한다.
// 예: 재고 있는 상품 먼저 1차 출고 → 나머지 상품 2차 출고.
//
// location_id: 출고 창고 또는 재고 위치 식별자.
// packed_at: 포장 완료 시각.
// shipped_at: 배송사 인수(출고) 시각.
// delivered_at: 고객 수령 완료 시각.
// canceled_at: 배송 취소 시각. null이면 취소되지 않은 상태.
// data: 배송사가 반환한 운송 데이터 (운송장 정보, 배송사 내부 ID 등).
// items: 이 배송 건에 포함된 아이템 목록.
// labels: 이 배송 건의 운송장·라벨 정보.
model Fulfillment {
  id           String    @id @default(cuid())
  location_id  String?
  data         Json?
  packed_at    DateTime?
  shipped_at   DateTime?
  delivered_at DateTime?
  canceled_at  DateTime?
  metadata     Json?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  provider_id        String?
  provider           FulfillmentProvider? @relation(fields: [provider_id], references: [id])
  shipping_option_id String?
  shipping_option    ShippingOption?      @relation(fields: [shipping_option_id], references: [id])
  items              FulfillmentItem[]
  labels             FulfillmentLabel[]
}

// Fulfillment에 포함된 개별 아이템 정보.
//
// 부분 배송 시 어떤 상품이 몇 개 포함됐는지 기록한다.
// title / sku / barcode: 배송 시점의 상품 정보 스냅샷 (창고·배송사 전달용).
// quantity: 이 배송 건에 포함된 해당 아이템 수량.
// line_item_id: 주문의 CartLineItem 또는 OrderLineItem 참조.
// inventory_item_id: 재고 모듈의 InventoryItem 참조 (재고 차감 연동에 사용).
model FulfillmentItem {
  id                String   @id @default(cuid())
  title             String
  sku               String?
  barcode           String?
  quantity          Int
  line_item_id      String?
  inventory_item_id String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  fulfillment_id String
  fulfillment    Fulfillment @relation(fields: [fulfillment_id], references: [id])
}

// 배송 운송장·라벨 정보.
//
// 하나의 Fulfillment에 여러 운송장이 있을 수 있다 (예: 합포장 후 분리 발송).
// tracking_number: 배송 추적 번호.
// tracking_url: 배송사 추적 페이지 URL (고객에게 노출).
// label_url: 배송 라벨 이미지 URL (창고 출력용).
model FulfillmentLabel {
  id              String   @id @default(cuid())
  tracking_number String
  tracking_url    String?
  label_url       String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  fulfillment_id String
  fulfillment    Fulfillment @relation(fields: [fulfillment_id], references: [id])
}

// 배송 업체(택배사·3PL) 등록 테이블.
//
// id: 배송 프로바이더 플러그인 식별자 (예: "fulfillment_manual", "fulfillment_dhl").
//     Medusa 배송 프로바이더 플러그인이 자동 등록한다.
// is_enabled: false로 설정하면 이 업체를 통한 신규 Fulfillment 생성이 차단된다.
// fulfillments: 이 업체가 처리한 배송 건 목록.
// shipping_options: 이 업체를 통해 제공되는 배송 옵션 목록.
model FulfillmentProvider {
  id         String   @id
  is_enabled Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fulfillments     Fulfillment[]
  shipping_options ShippingOption[]
}
