digraph MedusaERD {
  graph [
    rankdir=LR
    splines=polyline
    nodesep=0.55
    ranksep=1.4
    compound=true
    pad=0.5
  ]
  node [shape=none margin=0]
  edge [fontsize=7 fontname="Helvetica" arrowsize=0.75 dir=both]

  subgraph cluster_order {
    label="Order Module"
    style=filled
    fillcolor="#EBF1FA"
    color="#1A3A6B"
    penwidth=1.8
    fontname="Helvetica-Bold"
    fontsize=12
    fontcolor="#1A3A6B"

